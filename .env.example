APP_HOST=0.0.0.0
APP_PORT=8000
APP_HOST_PORT=8001

POSTGRES_DB=ragkb
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpass
POSTGRES_HOST_PORT=5433
DATABASE_URL=postgresql+asyncpg://raguser:ragpass@db:5432/ragkb

EMBEDDING_MODEL=intfloat/multilingual-e5-base
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Default: no LLM setup required (switch to ollama or openrouter for real answers).
LLM_PROVIDER=mock

# Option A: Ollama via compose profile
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_HOST_PORT=11435

# Option B: Ollama running on the host machine
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=llama3.2:3b

# Option C: OpenRouter
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

DEFAULT_SEARCH_LIMIT=10
HYBRID_CANDIDATE_COUNT=10
CHAT_CONTEXT_TOP_K=5

API_KEY=
